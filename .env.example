# GEMINI_API_KEY: Server-side only. Never expose this in browser code or VITE_ variables.
# Obtain a key from Google AI Studio and keep AI disabled until configured.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Set to "true" only after verifying your Gemini API billing/tier data-use controls
# and confirming that your workspace's data-handling agreement matches your policy.
AI_DATA_CONTROLS_VERIFIED="false"

# APP_URL: Public base URL of the running application (used for server metadata only).
APP_URL="http://localhost:3000"

# Supabase Configuration (Required for authenticated accounts & private report storage)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Server-side Supabase Service Role Key (Optional: for server-verified short-lived signed URLs)
# Never prefix this with VITE_ and never commit real values to GitHub.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
